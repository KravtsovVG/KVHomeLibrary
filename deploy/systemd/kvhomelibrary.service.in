[Unit]
Description=KVHomeLibrary — домашняя библиотека FB2 (OPDS)
Documentation=file:@INSTALL_DIR@/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@INSTALL_DIR@
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/kvhomelibrary.env
ExecStart=@PYTHON@ -m kvhomelibrary serve --db @DATA_DIR@/library.db --covers @DATA_DIR@/covers --library @LIBRARY_DIR@ --host @HOST@ --port @PORT@
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=@DATA_DIR@ @LIBRARY_DIR@/OPDS
UMask=0027

[Install]
WantedBy=multi-user.target
